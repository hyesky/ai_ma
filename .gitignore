# IDE
.idea/
.vs/
.vscode/
.qoder
.qtcreator

# Python
__pycache__/*
*$py.class
*.so
.Python

# env / build
venv/*
dist/*
build/*

# Django
# runtime artifacts
.allowed_hosts
.user_settings
.license

# spec files (PyInstaller build artifacts)
ai_ma.spec

# uploads / storage
static/storage/*
framework/__pycache__/*
app/__pycache__/*
app/migrations/*
app/migrations/__pycache__/*
app/comms/__pycache__/*
app/utils/__pycache__/*
app/views/__pycache__/*
app/services/__pycache__/*
app/analysis/__pycache__/*
app/analysis/engines/__pycache__/*
app/recording/__pycache__/*
# logs / docs / external services
docs/*
log/*
zlm/
zlm-work/
ffmpeg/
record/
www/
static/storage/*

# databases & runtime data (contains credentials / hashes — never commit)
*.sqlite3
*.sqlite3.bak*

# local backups (git history is the real backup — these are transient)
*.bak
*.bak.*
*.orig_green.bak
*.generated_blue.bak
